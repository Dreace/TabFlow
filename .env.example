# Build options belong in .build-tools.env. This file contains only secrets and
# machine-specific overrides used by the build submodule.

# Optional build overrides. The default project configuration already contains
# the Xcode project, scheme, export options and output paths.
# MACOS_CONFIGURATION=Release
# MACOS_CODE_SIGN_IDENTITY=Apple Distribution
# DEVELOPMENT_TEAM=QX4HATX9GM
# ALLOW_PROVISIONING_UPDATES=true

# Optional version/signing overrides.
# MARKETING_VERSION=1.0.1
# CURRENT_PROJECT_VERSION=2

# Optional non-interactive signing keychain settings.
# MACOS_KEYCHAIN_PATH=/Users/yourname/Library/Keychains/login.keychain-db
# MACOS_KEYCHAIN_PASSWORD=

# Direct distribution (Developer ID + notarized DMG).
# brew install create-dmg librsvg
# DEVELOPMENT_TEAM=QX4HATX9GM
# MACOS_DEVELOPER_ID_APPLICATION=Developer ID Application: Your Name (QX4HATX9GM)
# MACOS_DMG_RUN_TESTS=0

# App Store Connect API key. Used by upload scripts and DMG notarization.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_BASE64=

# Screenshot VM SSH. Used by Scripts/ssh-screenshot-vm.sh and
# Scripts/capture-screenshots.sh. Do not commit the password.
# SCREENSHOT_SSH_HOST=192.168.64.2
# SCREENSHOT_SSH_USER=screenshot
# SCREENSHOT_SSH_PASSWORD=

# Upload behavior. Keep both false until the package is verified.
ASC_SKIP_METADATA=true
ASC_SKIP_SCREENSHOTS=true
ASC_SUBMIT_FOR_REVIEW=false
ASC_AUTOMATIC_RELEASE=false
